# ──────────────────────────────────────────────────────────────────────────────
# Concord — environment variables
# Copy this file to `.env` and fill in the values. See README.md → "Local
# development" for where to obtain each key.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# `npm run db:up` starts a local instance that matches this default.
DATABASE_URL="postgresql://concord:concord@localhost:5432/concord"

# Clerk authentication — https://dashboard.clerk.com → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routing (these can stay as-is).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# UploadThing file uploads — https://uploadthing.com/dashboard → API keys.
UPLOADTHING_TOKEN=

# LiveKit audio/video (optional — only needed for AUDIO/VIDEO channels and
# 1:1 calls) — https://cloud.livekit.io → Settings → Keys.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
