{
	"name": "concord",
	"version": "1.0.0",
	"private": true,
	"description": "A real-time community platform built with Next.js, TypeScript, PostgreSQL and Server-Sent Events.",
	"engines": {
		"node": ">=20.9.0"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build --webpack",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"postinstall": "prisma generate"
	},
